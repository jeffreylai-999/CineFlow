	<parameter name="showDay" class="java.lang.String" isForPrompting="false"/>
	<parameter name="pay_Day" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select p.cus_type,m.movie_name,s.show_time,p.adult,p.child,p.payment_date,p.payment_type,p.total_price
from movie m,payment p,showtime s
where p.show_id = s.show_id AND m.movie_id=s.movie_id AND p.PAYMENT_DATE like $P{pay_Day}
ORDER BY p.cus_type]]>
	</queryString>
