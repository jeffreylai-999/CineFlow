# Local / Compose defaults (not for production secrets)
CINEFLOW_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cineflow
CINEFLOW_DATASOURCE_USERNAME=cineflow
CINEFLOW_DATASOURCE_PASSWORD=cineflow
CINEFLOW_DB_POOL_SIZE=5
CINEFLOW_JWT_SECRET=change-me-to-a-32-byte-or-longer-secret
CINEFLOW_BOOTSTRAP_ADMIN_USERNAME=administrator
CINEFLOW_BOOTSTRAP_ADMIN_PASSWORD=AdminPassw0rd!
CINEFLOW_AUTH_COOKIE_SECURE=false
CINEFLOW_TMDB_ACCESS_TOKEN=
CINEFLOW_OMDB_API_KEY=

