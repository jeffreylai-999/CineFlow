	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Row">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression>
			<style mode="Opaque" backcolor="#FFFF99"/>
		</conditionalStyle>
	</style>
	<parameter name="showMonth" class="java.lang.String"/>
	<parameter name="pay_month" class="java.lang.String"/>
	<queryString>
		<![CDATA[select p.cus_type,m.movie_name,(p.adult+p.child) AS totalseat,p.total_price,p.payment_date
from movie m,payment p,showtime s
where p.show_id = s.show_id AND m.movie_id=s.movie_id AND p.PAYMENT_DATE like $P{pay_month}
order by p.PAYMENT_DATE,p.cus_type]]>
	</queryString>
	<field name="CUS_TYPE" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="MOVIE_NAME" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="TOTALSEAT" class="java.lang.Integer"/>
	<field name="TOTAL_PRICE" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="PAYMENT_DATE" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="SUBTOTAL" class="java.lang.Double" resetType="Group" resetGroup="Date" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_PRICE}]]></variableExpression>
	</variable>
	<variable name="SumTotal" class="java.lang.Double" incrementType="Group" incrementGroup="Date" calculation="Sum">
		<variableExpression><![CDATA[$V{SUBTOTAL}]]></variableExpression>
	</variable>
	<variable name="GROUP_EXP" class="java.lang.Integer" resetType="Group" resetGroup="Date" calculation="Count">
		<variableExpression><![CDATA[new java.lang.Integer(1)]]></variableExpression>
		<initialValueExpression><![CDATA[new java.lang.Integer(0)]]></initialValueExpression>
	</variable>
