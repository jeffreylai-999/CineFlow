	<queryString>
		<![CDATA[select c.cus_id,c.cus_name,s.show_date,s.show_time,m.movie_name,p.payment_date,p.seat_no
from payment p,customer c,showtime s,movie m
where p.cus_id = c.cus_id AND p.show_id=s.show_id AND s.movie_id=m.movie_id AND p.PAYMENT_DATE like $P{pay_Day}]]>
	</queryString>
